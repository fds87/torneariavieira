{
  "name": "@tv/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/node.ts",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply torneariavieira --local",
    "db:migrate": "wrangler d1 migrations apply torneariavieira",
    "db:seed:local": "wrangler d1 execute torneariavieira --local --file=src/db/seed.sql",
    "db:seed": "wrangler d1 execute torneariavieira --file=src/db/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "hono": "^4.7.0",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250409.0",
    "@hono/node-server": "^1.19.13",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.0.0"
  }
}
